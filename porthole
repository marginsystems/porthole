#!/usr/bin/env python3
"""porthole: a small window onto a big, unfiltered mind.

Local uncensored Qwen on Apple Silicon + helper-model subagents (any OpenAI-compatible API) for the legwork.
"""

from __future__ import annotations

import contextlib
import json
import os
import platform
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request
from pathlib import Path

ROOT = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(ROOT))

VERSION = "0.1.0"
HF_REPO = "orcarouter/Qwen3.8-27B-Uncensored-MLX"
MODEL_DIR = ROOT / "Qwen3.8-27B-Uncensored-MLX"
STATE = ROOT / ".porthole"
PIDFILE = STATE / "server.pid"
LOGFILE = STATE / "server.log"
ACTIVITY = STATE / "activity"  # touched all through a turn; the server unloads once it and every connection go quiet


def idle_min() -> float:
    """Minutes of no use before the server unloads itself (QWEN_IDLE_MIN, also read from .env); 0: never."""
    import lowctx  # noqa: F401  (loads .env)
    try:
        return max(0.0, float(os.environ.get("QWEN_IDLE_MIN") or 5))
    except ValueError:
        return 5.0
PY = str(ROOT / ".venv" / "bin" / "python") if (ROOT / ".venv" / "bin" / "python").exists() else sys.executable

# ---------------------------------------------------------------- look

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"


def c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if COLOR else s


BRASS, GLASS, DIM, BOLD, RED, GREEN = "38;5;178", "38;5;38", "2", "1", "38;5;203", "38;5;114"

MARK = [  # porthole: brass rim, bolts, a lit glass pane
    "   ▄▄█▀▀▀█▄▄   ",
    " ▄█ ●     ● █▄ ",
    "█▀  ▗▄▄▄▄▄▖  ▀█",
    "█   ▐░░▒▓▒▌   █",
    "█▄  ▝▀▀▀▀▀▘  ▄█",
    " ▀█ ●     ● █▀ ",
    "   ▀▀█▄▄▄█▀▀   ",
]
WORD = [
    "                                      ",
    " ___  ___  ___ _____ _  _  ___  _    ___",
    "| _ \\/ _ \\| _ \\_   _| || |/ _ \\| |  | __|",
    "|  _/ (_) |   / | | | __ | (_) | |__| _|",
    "|_|  \\___/|_|_\\ |_| |_||_|\\___/|____|___|",
    "",
    "",
]


def paint_mark(line: str) -> str:
    if not COLOR:
        return line
    # glass is sea-teal, bolts pale brass, the rim brass
    return "".join(c(GLASS, ch) if ch in "░▒▓" else c("38;5;222", ch) if ch == "●"
                   else c(BRASS, ch) if ch.strip() else ch for ch in line)


def banner(tagline: str = "") -> None:
    tag = tagline or f"uncensored local minds · tiny context, long reach · v{VERSION}"
    for i, m in enumerate(MARK):
        w = WORD[i] if i < len(WORD) else ""
        if i == 5:
            w = c(DIM, "  " + tag)
        print(paint_mark(m) + "  " + c(BOLD, w) if i != 5 else paint_mark(m) + w)
    print()


def ok(s): print(f"  {c(GREEN, '●')} {s}")
def bad(s): print(f"  {c(RED, '●')} {s}")
def info(s): print(f"  {c(DIM, '·')} {s}")


# ---------------------------------------------------------------- server

def env() -> dict:
    import lowctx  # loads .env
    return {"url": lowctx.LOCAL_URL, "model": lowctx.DEFAULT_MODEL, "key": lowctx.HELPER_ON,
            "comp": lowctx.COMP_MODEL, "comp_url": lowctx.COMP_URL}


def weights_missing(quant: str) -> str | None:
    """What's missing from a model build, or None if it's complete. A half-finished pull has
    config.json but not every weight shard, so check the shards the index lists."""
    d = MODEL_DIR / quant
    try:
        idx = json.loads((d / "model.safetensors.index.json").read_text())
    except (OSError, ValueError):
        return "no model at all" if not (d / "config.json").exists() else "the weight index"
    shards = sorted(set(idx.get("weight_map", {}).values()))
    gone = [f for f in shards if not (d / f).is_file() or (d / f).stat().st_size == 0]
    if not (d / "config.json").exists():
        gone.insert(0, "config.json")
    return f"{len(gone)} of {len(shards)} weight files (download incomplete)" if gone else None


def server_up(url: str | None = None) -> bool:
    url = url or env()["url"]
    try:
        urllib.request.urlopen(url.rstrip("/") + "/models", timeout=2).read()
        return True
    except Exception:  # noqa: BLE001
        return False


def server_pid() -> int | None:
    """The pid of the server porthole started, if it is still that server. It exits on its own when idle,
    so the pid file is often stale, and the number may by now belong to some other process."""
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        cmd = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
        return pid if "mlx_vlm" in cmd or "start-server.sh" in cmd else None
    except Exception:  # noqa: BLE001
        return None


def cmd_up(quiet: bool = False, spawn_only: bool = False) -> int:
    """Start the model server and wait for it (spawn_only: start it loading and return at once)."""
    if server_up():
        if not quiet:
            ok("model server already running")
        return 0
    quant = os.environ.get("QWEN_QUANT", "4-bit")
    missing = weights_missing(quant)
    if missing:
        bad(f"{MODEL_DIR / quant} is missing {missing}. Run: porthole pull{'' if quant == '4-bit' else ' ' + quant}")
        return 1
    try:  # the weights need ~16 GB; loading into a swapping Mac makes everything crawl
        need = sum(f.stat().st_size for f in (MODEL_DIR / quant).glob("*.safetensors"))
        free = int(mem_free_pct().rstrip("%")) / 100 * int(subprocess.run(
            ["sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout)
        if free < need * 1.15:
            bad(f"only {free / 2**30:.0f} GB free, the model needs ~{need / 2**30:.0f} GB: expect heavy swapping "
                "and slow answers. Close big apps (VMs, games, DAWs, browsers) first.")
    except Exception:  # noqa: BLE001
        pass
    spawn_server()
    if spawn_only:
        return 0
    frames, t0 = "◐◓◑◒", time.time()
    tty = sys.stdout.isatty()
    if not tty:
        info(f"loading Qwen ({quant}) into memory…")

    def draw():
        if tty:
            sys.stdout.write(f"\r  {c(BRASS, frames[int(time.time() * 4) % 4])} loading Qwen ({quant}) into memory… "
                             f"{c(DIM, f'{time.time() - t0:.0f}s')}")
            sys.stdout.flush()
    err = wait_server(draw)
    if tty:
        sys.stdout.write("\r" + " " * 60 + "\r")
    if err:
        bad(err)
        return 1
    idle = f"unloads after {idle_min():g} min idle" if idle_min() > 0 else "stays loaded"
    ok(f"model server up in {time.time() - t0:.0f}s  {c(DIM, f'({idle}; porthole down frees the memory now)')}")
    return 0


def spawn_server() -> None:
    """Start the server in the background unless one is already starting."""
    if server_pid():
        return
    STATE.mkdir(exist_ok=True)
    touch_activity()  # a fresh load counts as use: don't unload before the first message arrives
    log = open(LOGFILE, "ab")
    env = {**os.environ, "PORTHOLE_IDLE_SECS": str(idle_min() * 60), "PORTHOLE_ACTIVITY": str(ACTIVITY)}
    p = subprocess.Popen([str(ROOT / "start-server.sh")], stdout=log, stderr=log, env=env,
                         stdin=subprocess.DEVNULL, start_new_session=True)
    PIDFILE.write_text(str(p.pid))


def wait_server(tick=lambda: None, limit: float = 300) -> str:
    """Wait for the server to answer. Returns "" when it does, else why not."""
    t0 = time.time()
    while not server_up():
        if not server_pid():
            return f"the model server exited while loading; see {LOGFILE}"
        if time.time() - t0 > limit:
            return f"model server not ready after {limit / 60:.0f} min; see {LOGFILE}"
        tick()
        time.sleep(0.25)
    return ""


def touch_activity() -> None:
    try:
        STATE.mkdir(exist_ok=True)
        ACTIVITY.touch()
    except OSError:
        pass


@contextlib.contextmanager
def model_ready():
    """Around each chat turn: load the model if it was unloaded while idle, and keep it loaded until the turn
    ends, tools and subagents included (the server only sees a connection while the model itself runs)."""
    import lowctx
    stop = threading.Event()

    def beat():
        while not stop.wait(20):
            touch_activity()
    touch_activity()
    if not server_up(lowctx.LOCAL_URL):
        if os.environ.get("LOWCTX_URL"):  # someone else's endpoint: not ours to start
            raise RuntimeError(f"no model server at {lowctx.LOCAL_URL}")
        lowctx.WAIT.show("loading Qwen into memory")
        if not server_pid() and cmd_up(quiet=True, spawn_only=True):
            raise RuntimeError("could not start the model server (porthole doctor)")
        err = wait_server()
        if err:
            raise RuntimeError(err)
        lowctx.WAIT.show("sending")
    t = threading.Thread(target=beat, daemon=True)
    t.start()
    try:
        yield
    finally:
        stop.set()
        touch_activity()  # the idle clock starts when the reply is done


def cmd_down() -> int:
    pid = server_pid()
    killed = False
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)
        except Exception:  # noqa: BLE001
            os.kill(pid, signal.SIGTERM)
        killed = True
    # also catch a server started by hand with start-server.sh
    r = subprocess.run(["pkill", "-f", f"mlx_vlm server --model {MODEL_DIR}"], capture_output=True)
    killed = killed or r.returncode == 0
    PIDFILE.unlink(missing_ok=True)
    for _ in range(40):
        if not server_up():
            break
        time.sleep(0.25)
    (ok if killed else info)("model server stopped, memory freed" if killed else "no model server was running")
    return 0


def mem_free_pct() -> str:
    try:
        out = subprocess.run(["memory_pressure"], capture_output=True, text=True, timeout=5).stdout
        return out.strip().splitlines()[-1].split(":")[-1].strip()
    except Exception:  # noqa: BLE001
        return "?"


def cmd_status() -> int:
    e = env()
    banner()
    (ok if server_up() else bad)(f"model server  {e['url']}  " + ("up" if server_up() else "down  (porthole up)"))
    quant = os.environ.get("QWEN_QUANT", "4-bit")
    (ok if (MODEL_DIR / quant).exists() else bad)(f"model         {MODEL_DIR.name}/{quant}")
    (ok if e["key"] else info)(f"subagents     {e['comp'] + ' via ' + e['comp_url'] if e['key'] else 'off (set HELPER_KEY or HELPER_URL in .env)'}")
    info(f"idle unload   " + (f"after {idle_min():g} min with no use (QWEN_IDLE_MIN; 0 keeps it loaded)" if idle_min() > 0
                              else "off (QWEN_IDLE_MIN=0)"))
    info(f"free memory   {mem_free_pct()}")
    return 0


def cmd_doctor() -> int:
    banner("doctor")
    good = True
    mac = platform.system() == "Darwin" and platform.machine() == "arm64"
    (ok if mac else bad)(f"Apple Silicon macOS ({platform.system()} {platform.machine()})")
    good &= mac
    try:
        ram = int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout) / 2**30
        (ok if ram >= 32 else bad)(f"RAM {ram:.0f} GB  {c(DIM, '(4-bit needs ~16 GB + headroom; 32 GB+ recommended)')}")
    except Exception:  # noqa: BLE001
        pass
    has_mlx = subprocess.run([PY, "-c", "import mlx_vlm"], capture_output=True).returncode == 0
    (ok if has_mlx else bad)(f"mlx-vlm installed ({PY})" if has_mlx else "mlx-vlm missing: run ./install.sh")
    good &= has_mlx
    quant = os.environ.get("QWEN_QUANT", "4-bit")
    missing = weights_missing(quant)
    have = missing is None
    (ok if have else bad)(f"model weights {MODEL_DIR.name}/{quant}" if have
                          else f"model weights: missing {missing}. Run: porthole pull")
    good &= have
    e = env()
    (ok if e["key"] else info)(f"helper model {e['comp']} configured (subagents on)" if e["key"]
                           else "no helper model: subagents off, local model summarizes (slow)")
    import lowctx
    if lowctx.HELPER_EXTRA_ERR:
        bad(f"HELPER_EXTRA_BODY ignored: {lowctx.HELPER_EXTRA_ERR} (must be a JSON object)")
        good = False
    for tool, why in (("rg", "faster grep"), ("pdftotext", "read PDFs (brew install poppler)")):
        (ok if shutil.which(tool) else info)(f"{tool:9} {'found' if shutil.which(tool) else 'optional: ' + why}")
    (ok if server_up() else info)("model server running" if server_up() else "model server not running (porthole up)")
    print()
    return 0 if good else 1


def cmd_pull(argv: list) -> int:
    quant = argv[0] if argv else os.environ.get("QWEN_QUANT", "4-bit")
    hf = shutil.which("hf") or shutil.which("huggingface-cli")
    if not hf:
        cand = ROOT / ".venv" / "bin" / "hf"
        hf = str(cand) if cand.exists() else None
    if not hf:
        bad("Hugging Face CLI not found. Install it: pip install -U huggingface_hub")
        return 1
    info(f"downloading {HF_REPO} [{quant}] → {MODEL_DIR}  {c(DIM, '(~15 GB for 4-bit; resumable)')}")
    return subprocess.call([hf, "download", HF_REPO, "--include", f"{quant}/*", "--local-dir", str(MODEL_DIR)])


# ---------------------------------------------------------------- chat

def chat_header(agent) -> None:
    banner()
    e = env()
    sub = f"{e['comp']}" if e["key"] else "off"
    info(f"mode {c(BOLD, agent.mode)}  ·  {agent.tools.where}  ·  budget {agent.budget // 1000}k tok  ·  subagents {sub}")
    info('/new  /notes  /mode code|advisor  /incognito  /help  /quit   ·   paste anything  ·  Ctrl+C stops a reply')
    print()


HELP = f"""{c(BOLD, 'usage')}
  porthole                       chat (advisor mode) in the current folder; resumes the last
                                 session there (--new or /new starts fresh)
  porthole chat [--mode code|advisor] [first message]
  porthole run  "task"           one-shot: do the task in this folder, print the result, exit
                                 (code mode; add --mode advisor for a one-shot opinion)
  porthole chat --mode code --ssh myserver:/srv/app
                                 work on a folder on another machine over ssh (key login)
  porthole up | down             start / stop the local model server (frees ~16 GB when down)
  porthole status                server, model, subagents, free memory
  porthole doctor                check this machine and the install
  porthole pull [4-bit|6-bit|8-bit]   download Qwen weights from Hugging Face
  porthole gui                   open the lab in a browser: chat with confidence colours,
                                 the model's anatomy, a test suite (needs Node; does not load the model)

{c(BOLD, 'chat flags')}  --cwd DIR  --ssh HOST:PATH  --new  --budget TOKENS  --steps N  --think  --no-stream
{c(BOLD, 'env')}         HELPER_URL HELPER_KEY HELPER_MODEL (in .env)  QWEN_QUANT  QWEN_KV  QWEN_IDLE_MIN  LOWCTX_URL  LOWCTX_MODEL
"""


def cmd_chat(argv: list, one_shot: bool = False) -> int:
    import lowctx
    if not server_up(lowctx.LOCAL_URL):
        if os.environ.get("LOWCTX_URL"):  # someone else's endpoint: don't try to start ours
            bad(f"no model server at {lowctx.LOCAL_URL}")
            return 1
        # load while the user types; the first turn waits for it if needed
        if cmd_up(quiet=True, spawn_only=True):
            return 1
    if one_shot:
        if "--mode" not in argv:
            argv = ["--mode", "code", *argv]
        argv = ["--once", *argv]
    lowctx.main(argv, header=None if one_shot else chat_header, prog="porthole chat", turn_guard=model_ready)
    return 0


def cmd_gui() -> int:
    """The browser lab in gui/ (Vite + TypeScript). Installs its packages on first run."""
    gui = ROOT / "gui"
    npm = shutil.which("npm")
    if not npm:
        bad("porthole gui needs Node.js (npm): brew install node")
        return 1
    if not (gui / "node_modules").exists():
        info("installing the lab's packages (first run)…")
        if subprocess.run([npm, "install", "--no-fund", "--no-audit"], cwd=gui).returncode:
            return 1
    try:
        return subprocess.run([npm, "run", "dev", "--", "--open"], cwd=gui).returncode
    except KeyboardInterrupt:
        return 0


def main() -> int:
    argv = sys.argv[1:]
    cmd = argv[0] if argv and not argv[0].startswith("-") else "chat"
    rest = argv[1:] if argv and argv[0] == cmd else argv
    if cmd in ("-h", "--help", "help") or "--help" in argv[:1]:
        banner()
        print(HELP)
        return 0
    if cmd in ("-v", "--version", "version") or argv[:1] in (["-v"], ["--version"]):
        print(f"porthole {VERSION}")
        return 0
    table = {
        "chat": lambda: cmd_chat(rest),
        "run": lambda: cmd_chat(rest, one_shot=True),
        "up": cmd_up, "down": cmd_down, "status": cmd_status, "doctor": cmd_doctor,
        "pull": lambda: cmd_pull(rest), "gui": cmd_gui,
    }
    if cmd not in table:  # `porthole what should I do about X` → chat with that as the first message
        return cmd_chat(argv)
    return table[cmd]()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print()
        sys.exit(130)
